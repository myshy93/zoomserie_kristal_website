{
  "name": "zoomserie_kristal_website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:cleanup:local": "wrangler d1 execute DB --local --file=db/cleanup.sql",
    "cleanup:dev": "wrangler dev --config workers/cleanup/wrangler.jsonc --test-scheduled --persist-to .wrangler/state",
    "cleanup:deploy": "wrangler deploy --config workers/cleanup/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
