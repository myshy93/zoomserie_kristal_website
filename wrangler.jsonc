{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "zoomserie-kristal-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Owner email notifications via Mailjet (src/lib/server/notify.ts). Secrets, set with
	// `wrangler secret put` (or in .dev.vars locally): MAILJET_API_KEY, MAILJET_SECRET_KEY,
	// OWNER_EMAIL. MAIL_FROM_EMAIL must be a validated Mailjet sender; email is skipped while empty.
	"vars": {
		"MAIL_FROM_EMAIL": "dinusoftcraft@gmail.com",
		"MAIL_FROM_NAME": "Zoomserie",
		"PUBLIC_GOOGLE_MAPS_EMBED_KEY": "AIzaSyApb18jLCSn0_79WiEhl8gRK_-78vykH6M"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zoomserie-db",
			"database_id": "cf0a6146-cf3d-4be3-9acf-79cbcf2271d0",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "QUOTE_PHOTOS",
			"bucket_name": "zoomserie-quote-photos"
		}
	]
}
