{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "zoomserie-kristal-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Owner email notifications (src/lib/server/notify.ts). Secrets, set with
	// `wrangler secret put` (or in .dev.vars locally): RESEND_API_KEY, OWNER_EMAIL.
	// MAIL_FROM switches to an address on the real domain once it's verified in Resend.
	"vars": {
		"MAIL_FROM": "Zoomserie <onboarding@resend.dev>"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zoomserie-db",
			"database_id": "cf0a6146-cf3d-4be3-9acf-79cbcf2271d0",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "QUOTE_PHOTOS",
			"bucket_name": "zoomserie-quote-photos"
		}
	]
}
