---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import MapEmbed from '../components/MapEmbed.astro';
import OpeningHours from '../components/OpeningHours.astro';
import { site } from '../config/site';
import { localized, path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(t('whatsapp.prefill'))}`;
---

<BaseLayout lang={lang} title={t('contact.title')} paths={localized((l) => path('contact', l))}>
  <LocalBusinessSchema slot="head" lang={lang} />

  <section class="mx-auto max-w-4xl px-4 py-14">
    <h1 class="text-5xl">{t('contact.title')}</h1>
    <p class="mt-4 text-lg text-charcoal/70">{t('contact.intro')}</p>

    <div class="mt-10 grid gap-10 sm:grid-cols-2">
      <div>
        <dl class="space-y-6">
          <div>
            <dt class="text-xs font-bold tracking-wider text-olive uppercase">{t('contact.phone')}</dt>
            <dd><a href={`tel:${site.phone.replace(/\s/g, '')}`} class="font-medium text-terracotta-dark hover:underline">{site.phone}</a></dd>
          </div>
          <div>
            <dt class="text-xs font-bold tracking-wider text-olive uppercase">{t('contact.email')}</dt>
            <dd><a href={`mailto:${site.email}`} class="font-medium text-terracotta-dark hover:underline">{site.email}</a></dd>
          </div>
          <div>
            <dt class="text-xs font-bold tracking-wider text-olive uppercase">{t('contact.address')}</dt>
            <dd class="mt-1 text-charcoal/70">{site.address}</dd>
          </div>
        </dl>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="btn mt-8 bg-[#25d366] text-charcoal hover:brightness-95"
        >
          {t('contact.whatsapp')}
        </a>
      </div>

      <OpeningHours lang={lang} />
    </div>

    <section class="mt-14">
      <h2 class="mb-4 text-3xl font-semibold">{t('contact.findUs')}</h2>
      <MapEmbed lang={lang} />
    </section>

    <section id="legal" class="mt-14 border-t border-charcoal/10 pt-8">
      <h2 class="text-3xl font-semibold">{t('contact.legal')}</h2>
      <dl class="mt-4 space-y-1 text-charcoal/70">
        <div><dt class="inline">Denumire:</dt> <dd class="inline">{site.legal.companyName}</dd></div>
        <div><dt class="inline">CUI:</dt> <dd class="inline">{site.legal.cui}</dd></div>
        <div><dt class="inline">Nr. Reg. Com.:</dt> <dd class="inline">{site.legal.regCom}</dd></div>
      </dl>
    </section>
  </section>
</BaseLayout>
