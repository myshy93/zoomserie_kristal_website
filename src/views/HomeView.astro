---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import CategoryTile from '../components/CategoryTile.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Laurel from '../components/Laurel.astro';
import VisitUs from '../components/VisitUs.astro';
import { site } from '../config/site';
import { categoryImage, getCategories, PLACEHOLDER_IMAGE } from '../lib/catalog';
import { localized, path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const categories = await getCategories();
const byId = new Map(categories.map((c) => [c.id, c]));
// Home tiles: first row of three, second row of two.
const featured = ['prajituri', 'torturi', 'cafea', 'gift-box', 'tort-nunta']
  .map((id) => byId.get(id))
  .filter((c) => c !== undefined);
// The hero goes full-bleed once the Greek collection's photo flag is on.
const greek = byId.get('greek-collection');
const hero = greek ? categoryImage(greek) : { image: PLACEHOLDER_IMAGE, srcset: undefined, isPlaceholder: true };
// The hero is shown full width, so it also gets the near-lossless full-size file.
const heroFull = hero.image.replace('-1200.', '-full.');
const heroSrcset = hero.srcset && heroFull !== hero.image ? `${hero.srcset}, ${heroFull} 1448w` : hero.srcset;

const circle = (cx: number, cy: number, r: number) =>
  `M${(cx - r).toFixed(2)} ${cy.toFixed(2)}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0`;

const values = [
  {
    title: t('home.values.ingredientsTitle'),
    body: t('home.values.ingredientsBody'),
    icon: 'M5 19c9 0 14-6 14-14C11 5 5 10 5 19zm0 0 8-8',
  },
  {
    title: t('home.values.greekTitle'),
    body: t('home.values.greekBody'),
    icon: 'M3 9h18L12 4 3 9zm2 0v9m4-9v9m6-9v9m4-9v9M3 18h18M2 21h20',
  },
  {
    title: t('home.values.customTitle'),
    body: t('home.values.customBody'),
    // Five petals around a centre.
    icon: [0, 72, 144, 216, 288]
      .map((deg) => (deg - 90) * (Math.PI / 180))
      .map((rad) => circle(12 + 4.6 * Math.cos(rad), 12 + 4.6 * Math.sin(rad), 3.2))
      .concat(circle(12, 12, 1.8))
      .join(''),
  },
  {
    title: t('home.values.deliveryTitle'),
    body: t('home.values.deliveryBody', { threshold: site.freeDeliveryThresholdRon }),
    icon: 'M3 7h11v9H3zm11 3h4l3 3v3h-7M7 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z',
  },
];
---

<BaseLayout lang={lang} paths={localized((l) => path('home', l))}>
  <LocalBusinessSchema slot="head" lang={lang} />

  <section
    class:list={['relative overflow-hidden border-b border-ink/10 bg-ivory', !hero.isPlaceholder && 'lg:-mt-[var(--header-h)]']}
  >
    {
      hero.isPlaceholder ? (
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_50%,var(--color-sand)_0%,transparent_60%)]" />
      ) : (
        // Below lg: the whole photo (4:3, uncropped) under the header, text underneath.
        // From lg up: full-bleed behind the text and under the header.
        <div class="relative aspect-[4/3] overflow-hidden lg:absolute lg:inset-0 lg:aspect-auto">
          <img
            src={heroFull}
            srcset={heroSrcset}
            sizes="100vw"
            alt=""
            width="1200"
            height="900"
            fetchpriority="high"
            class="hero-photo size-full -scale-x-100 object-cover saturate-[0.82] contrast-[0.97] lg:translate-x-[6%]"
          />
          <div class="absolute inset-x-0 top-0 -bottom-px bg-linear-to-t from-ivory from-3% via-ivory/35 via-18% to-transparent to-40% lg:bg-linear-to-r lg:from-ivory lg:from-15% lg:via-ivory/60 lg:via-35% lg:to-transparent lg:to-62%" />
        </div>
      )
    }
    <div
      class:list={[
        'relative mx-auto grid max-w-7xl items-center gap-12 px-4 pb-16 sm:px-6 lg:grid-cols-2 lg:px-8 lg:pb-24',
        hero.isPlaceholder ? 'pt-16 lg:pt-24' : '-mt-6 pt-0 lg:mt-0 lg:pt-[calc(var(--header-h)+4rem)]',
      ]}
    >
      <div class="text-center">
        <h1 class="hero-rise text-5xl sm:text-6xl lg:text-7xl" style="--delay: 150ms">{t('home.hero.title')}</h1>
        <p class="hero-rise caps mt-6 text-xs tracking-[0.35em] text-ink/80" style="--delay: 300ms">{t('home.hero.eyebrow')}</p>
        <div class="hero-rise mt-9 flex flex-wrap items-center justify-center gap-x-8 gap-y-1" style="--delay: 450ms">
          <a
            href={path('products', lang)}
            class="btn btn-primary px-9 py-3.5 font-sans text-xs tracking-[0.2em] uppercase"
            >{t('home.hero.ctaProducts')}</a
          >
          <a href={path('quote', lang)} class="caps inline-block py-3.5 text-ink transition hover:text-bronze">{t('home.hero.ctaQuote')} →</a>
        </div>
      </div>
      {
        hero.isPlaceholder && (
          <figure class="mx-auto hidden w-full max-w-sm lg:block">
            <div class="aspect-[4/5] overflow-hidden rounded-t-full border border-ink/10 bg-sand">
              <img src={hero.image} alt="" class="size-full object-cover" />
            </div>
            <figcaption class="caps mt-3 text-center text-[10px] text-muted">{t('product.photoSoon')}</figcaption>
          </figure>
        )
      }
    </div>
  </section>

  <section class="border-b border-ink/10 bg-ivory">
    <ul class="mx-auto grid max-w-7xl grid-cols-1 gap-y-8 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:divide-x lg:divide-ink/10 lg:px-8">
      {
        values.map((value) => (
          <li class="flex items-center gap-4 px-4 lg:justify-center">
            <svg viewBox="0 0 24 24" class="size-10 shrink-0 text-bronze" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" aria-hidden="true">
              <path d={value.icon} />
            </svg>
            <div>
              <p class="font-serif text-xl leading-tight">{value.title}</p>
              <p class="mt-1 font-sans text-xs leading-snug text-muted">{value.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="grid gap-2 bg-ivory-light py-2" aria-labelledby="home-categories">
    <h2 id="home-categories" class="sr-only">{t('home.categories.title')}</h2>
    {/* Swipeable strip on phones and tablets; from lg up a 3 + 2 grid (11/11/11, then 15/18 of 33 columns). */}
    <div
      class="flex snap-x snap-mandatory scroll-px-4 gap-2 overflow-x-auto px-4 [scrollbar-width:none] lg:grid lg:grid-cols-33 lg:overflow-visible lg:px-0 [&::-webkit-scrollbar]:hidden"
    >
      {
        featured.map((category, i) => (
          <CategoryTile
            category={category}
            lang={lang}
            class:list={[
              'w-[78%] max-w-[22rem] shrink-0 snap-start sm:w-[45%] lg:w-auto lg:max-w-none',
              i < 3 ? 'lg:col-span-11' : i === 3 ? 'lg:col-span-15' : 'lg:col-span-18',
            ]}
          />
        ))
      }
    </div>
  </section>

  <HowItWorks lang={lang} />

  <VisitUs lang={lang} />

  <section class="bg-linear-to-b from-ivory to-sand px-4 py-20 text-center">
    <p class="mx-auto max-w-3xl font-serif text-3xl sm:text-4xl">{t('home.quote')}</p>
    <Laurel class="mx-auto mt-8 w-14 text-bronze" />
    <p class="font-serif text-lg tracking-[0.3em] uppercase">{site.name}</p>
    <span class="mx-auto mt-3 block h-px w-16 bg-ink/40" aria-hidden="true"></span>
  </section>
</BaseLayout>
