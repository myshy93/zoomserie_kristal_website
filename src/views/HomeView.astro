---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { site } from '../config/site';
import { categoryImage, categoryUrl, getCategories } from '../lib/catalog';
import { localized, path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const categories = await getCategories();
---

<BaseLayout lang={lang} paths={localized((l) => path('home', l))}>
  <section class="bg-cream-deep/60">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
      <h1 class="max-w-2xl text-4xl font-bold sm:text-5xl">{t('home.hero.title')}</h1>
      <p class="mt-4 max-w-xl text-lg text-cocoa-soft">{t('home.hero.subtitle')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={path('products', lang)} class="rounded-full bg-berry px-6 py-3 font-semibold text-white hover:bg-berry-dark">
          {t('home.hero.ctaProducts')}
        </a>
        <a
          href={path('quote', lang)}
          class="rounded-full border border-berry px-6 py-3 font-semibold text-berry hover:bg-berry hover:text-white"
        >
          {t('home.hero.ctaQuote')}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="text-3xl font-bold">{t('home.categories.title')}</h2>
    <ul class="mt-8 grid grid-cols-2 gap-6 md:grid-cols-4">
      {
        categories.map((category) => {
          const { image, isPlaceholder } = categoryImage(category);
          return (
            <li>
              <a href={categoryUrl(category, lang)} class="group block">
                <Photo src={image} alt={category.data.name[lang]} isPlaceholder={isPlaceholder} lang={lang} />
                <p class="mt-2 font-semibold group-hover:text-berry">{category.data.name[lang]}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4">
    <div class="rounded-3xl bg-caramel/15 px-6 py-10 sm:px-10">
      <h2 class="text-2xl font-bold">{t('home.delivery.title', { threshold: site.freeDeliveryThresholdRon })}</h2>
      <p class="mt-2 max-w-2xl text-cocoa-soft">{t('home.delivery.body')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="text-3xl font-bold">{t('home.gallery.title')}</h2>
    <p class="mt-2 text-cocoa-soft">{t('home.gallery.body')}</p>
    <a href={path('gallery', lang)} class="mt-4 inline-block font-semibold text-berry hover:underline">
      {t('nav.gallery')} →
    </a>
  </section>
</BaseLayout>
