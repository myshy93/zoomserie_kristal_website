---
// Draft privacy policy; the text lives in src/i18n/privacy.ts (see the notes there on
// what to keep in sync). To be reviewed by the client before launch.
import BaseLayout from '../layouts/BaseLayout.astro';
import { privacyPolicy, updated } from '../i18n/privacy';
import { localized, path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { intro, sections } = privacyPolicy(lang, { cookies: path('cookies', lang) });
const updatedLabel = new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(new Date(updated));
---

<BaseLayout lang={lang} title={t('privacy.title')} paths={localized((l) => path('privacy', l))}>
  <section class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="text-4xl font-bold">{t('privacy.title')}</h1>
    <p class="mt-6 text-lg leading-relaxed text-cocoa-soft">{intro}</p>

    <div class="policy">
      {
        sections.map((section) => (
          <>
            <h2 class="mt-10 text-2xl font-bold">{section.title}</h2>
            {section.blocks.map((block) =>
              Array.isArray(block) ? (
                <ul class="mt-3 list-disc space-y-2 pl-6 leading-relaxed text-cocoa-soft">
                  {block.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              ) : (
                <p class="mt-3 leading-relaxed text-cocoa-soft" set:html={block} />
              ),
            )}
          </>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-cocoa-soft">{t('privacy.updated', { date: updatedLabel })}</p>
  </section>
</BaseLayout>

<style>
  .policy :global(a) {
    color: var(--color-berry);
  }
  .policy :global(a:hover) {
    text-decoration: underline;
  }
  .policy :global(strong) {
    color: var(--color-cocoa);
  }
</style>
