---
// Cart + checkout. Lines live in localStorage (src/lib/cart.ts) and are rendered by
// the script below; the whole order goes to /api/orders as one request, which
// recomputes prices server-side (src/lib/server/pricing.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactFields from '../components/ContactFields.astro';
import { site } from '../config/site';
import { localized, path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const config = {
  lang,
  locale: lang === 'ro' ? 'ro-RO' : 'en-GB',
  threshold: site.freeDeliveryThresholdRon,
  strings: {
    remove: t('cart.remove'),
    quantity: t('order.quantity'),
    message: t('order.message'),
    freeReached: t('cart.freeDeliveryReached'),
    freeProgress: t('cart.freeDeliveryProgress', { amount: '{amount}' }),
    sending: t('cart.sending'),
    submit: t('order.submit'),
    error: t('cart.error'),
    errorStale: t('cart.errorStale'),
    errorFields: t('cart.errorFields', { fields: '{fields}' }),
    orderId: t('cart.orderId', { id: '{id}' }),
    fields: {
      lastName: t('order.lastName'),
      firstName: t('order.firstName'),
      phone: t('order.phone'),
      address: t('order.address'),
    },
    unit: {
      bucata: t('unit.bucata'),
      kg: t('unit.kg'),
      portie: t('unit.portie'),
      cutie: t('unit.cutie'),
    },
  },
};
---

<BaseLayout lang={lang} title={t('cart.title')} paths={localized((l) => path('cart', l))}>
  <section class="mx-auto max-w-3xl px-4 py-14" data-cart data-config={JSON.stringify(config)}>
    <h1 class="text-5xl">{t('cart.title')}</h1>

    <div data-empty hidden class="mt-8 card p-6 sm:p-8">
      <p class="text-muted">{t('cart.empty')}</p>
      <a
        href={path('products', lang)}
        class="btn btn-primary mt-4"
      >
        {t('home.hero.ctaProducts')}
      </a>
    </div>

    <div data-success hidden role="status" class="mt-8 card p-6 sm:p-8">
      <h2 class="text-3xl">{t('cart.successTitle')}</h2>
      <p class="mt-2 text-muted">{t('cart.successBody')}</p>
      <p class="mt-4 font-semibold" data-order-id></p>
      <a href={path('home', lang)} class="link mt-4 inline-block">{t('nav.home')}</a>
    </div>

    <div data-filled hidden class="mt-8 space-y-8">
      <ul class="space-y-4" data-lines></ul>

      <div class="card p-6 sm:p-8">
        <p class="flex justify-between font-serif text-3xl font-medium">
          <span>{t('cart.total')}</span>
          <span data-total></span>
        </p>
        <div class="mt-4" data-free-delivery>
          <div class="h-2 overflow-hidden rounded-full bg-sand">
            <div class="h-full bg-bronze transition-all" data-progress style="width:0%"></div>
          </div>
          <p class="mt-2 text-sm text-muted" data-free-delivery-text></p>
        </div>
        <p class="mt-2 text-xs text-muted">{t('cart.deliveryFeeNote', { threshold: site.freeDeliveryThresholdRon })}</p>
      </div>

      <form class="space-y-6 card p-6 sm:p-8" data-checkout>
        <h2 class="text-3xl">{t('order.title')}</h2>

        <fieldset>
          <legend class="text-sm font-medium">{t('order.fulfillment')}</legend>
          <div class="mt-2 flex flex-wrap gap-4">
            <label class="flex items-center gap-2">
              <input type="radio" name="fulfillment" value="delivery" checked class="accent-bronze" />
              {t('order.delivery')}
            </label>
            <label class="flex items-center gap-2">
              <input type="radio" name="fulfillment" value="pickup" class="accent-bronze" />
              {t('order.pickup')}
            </label>
          </div>
        </fieldset>

        <ContactFields lang={lang} />

        <label class="block text-sm font-medium">
          {t('order.notes')}
          <textarea name="notes" rows="3" class="field"></textarea>
        </label>

        <p class="text-sm text-muted">{t('order.disclaimer')}</p>
        <p class="text-sm text-muted">
          {t('privacy.formNotice')}{' '}
          <a href={path('privacy', lang)} target="_blank" class="link">{t('privacy.formLink')}</a>.
        </p>
        <p role="alert" class="text-sm font-medium text-red-700" data-error hidden></p>
        <button
          type="submit"
          class="btn btn-primary"
        >
          {t('order.submit')}
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { cartTotal, clearCart, lineTotal, quantityStep, removeLine, setQuantity, watchCart, type CartLine } from '../lib/cart';

  const root = document.querySelector<HTMLElement>('[data-cart]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const { lang, locale, threshold, strings } = JSON.parse(root.dataset.config!) as {
      lang: 'ro' | 'en';
      locale: string;
      threshold: number;
      strings: Record<string, any>;
    };
    const money = new Intl.NumberFormat(locale, { style: 'currency', currency: 'RON' });
    const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const form = $<HTMLFormElement>('[data-checkout]');
    const list = $('[data-lines]');
    const errorBox = $('[data-error]');
    let submitted = false;

    const show = (state: 'empty' | 'filled' | 'success') => {
      $('[data-empty]').hidden = state !== 'empty';
      $('[data-filled]').hidden = state !== 'filled';
      $('[data-success]').hidden = state !== 'success';
    };

    const el = (tag: string, className = '', text = '') => {
      const node = document.createElement(tag);
      node.className = className;
      node.textContent = text;
      return node;
    };

    function renderLine(line: CartLine) {
      const item = el('li', 'card p-5');
      const head = el('div', 'flex items-start justify-between gap-4');
      const title = el('a', 'font-serif text-2xl font-medium hover:text-bronze', line.display.name[lang]) as HTMLAnchorElement;
      title.href = line.display.url[lang];
      head.append(title, el('span', 'font-serif text-xl font-medium', money.format(lineTotal(line))));
      item.append(head);

      const details = [...line.display.options.map((o) => o[lang])];
      if (line.message) details.push(`${strings.message}: „${line.message}”`);
      details.push(`${money.format(line.unitPriceRon)} / ${strings.unit[line.unit] ?? line.unit}`);
      item.append(el('p', 'mt-1 text-sm text-muted', details.join(' · ')));

      const controls = el('div', 'mt-4 flex items-center gap-4');
      const qty = document.createElement('input');
      const step = quantityStep(line.unit);
      qty.type = 'number';
      qty.min = String(step);
      qty.step = String(step);
      qty.value = String(line.quantity);
      qty.setAttribute('aria-label', `${strings.quantity} – ${line.display.name[lang]}`);
      qty.className = 'field mt-0 w-24 py-1.5';
      qty.addEventListener('change', () => setQuantity(line.key, Number(qty.value) || step));
      const remove = el('button', 'text-sm text-muted underline hover:text-bronze', strings.remove) as HTMLButtonElement;
      remove.type = 'button';
      remove.addEventListener('click', () => removeLine(line.key));
      controls.append(qty, el('span', 'text-sm text-muted', strings.unit[line.unit] ?? line.unit), remove);
      item.append(controls);
      return item;
    }

    watchCart((lines) => {
      if (submitted) return;
      if (lines.length === 0) return show('empty');
      show('filled');
      list.replaceChildren(...lines.map(renderLine));

      const total = cartTotal(lines);
      $('[data-total]').textContent = money.format(total);
      $('[data-progress]').style.width = `${Math.min(100, (total / threshold) * 100)}%`;
      $('[data-free-delivery-text]').textContent =
        total >= threshold
          ? strings.freeReached
          : strings.freeProgress.replace('{amount}', money.format(threshold - total));
    });

    // The address is only needed (and required) for delivery.
    const address = form.querySelector<HTMLElement>('[data-address]');
    const syncAddress = () => {
      const delivery = form.querySelector<HTMLInputElement>('input[name="fulfillment"]:checked')?.value === 'delivery';
      if (!address) return;
      address.hidden = !delivery;
      address.querySelector('input')!.required = delivery;
    };
    form.addEventListener('change', syncAddress);
    syncAddress();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const lines = JSON.parse(localStorage.getItem('zoomserie.cart.v1') ?? '[]') as CartLine[];
      if (lines.length === 0) return;
      const data = new FormData(form);
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      button.textContent = strings.sending;
      errorBox.hidden = true;
      try {
        const response = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          // No prices: the server recomputes them from the catalog.
          body: JSON.stringify({
            lang,
            fulfillment: data.get('fulfillment'),
            lastName: data.get('lastName'),
            firstName: data.get('firstName'),
            phone: data.get('phone'),
            address: data.get('address') ?? '',
            notes: data.get('notes') ?? '',
            website: data.get('website') ?? '',
            items: lines.map(({ productId, unit, variations, message, quantity }) => ({
              productId,
              unit,
              variations,
              message,
              quantity,
            })),
          }),
        });
        const result = (await response.json().catch(() => ({}))) as { orderId?: string };
        if (!response.ok) throw Object.assign(new Error(String(response.status)), { result });
        submitted = true;
        clearCart();
        $('[data-order-id]').textContent = strings.orderId.replace('{id}', result.orderId);
        show('success');
        window.scrollTo({ top: 0 });
      } catch (error) {
        const result = (error as { result?: { error?: string; fields?: Record<string, string> } }).result;
        const contactFields = Object.keys(result?.fields ?? {})
          .map((name) => strings.fields[name])
          .filter(Boolean);
        errorBox.textContent =
          result?.error === 'invalid_items'
            ? strings.errorStale
            : contactFields.length > 0
              ? strings.errorFields.replace('{fields}', contactFields.join(', '))
              : strings.error;
        errorBox.hidden = false;
        button.disabled = false;
        button.textContent = strings.submit;
      }
    });
  }
</script>
