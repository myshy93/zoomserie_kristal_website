---
// Simple title + body page, used for Despre and Galerie until they get real content.
import BaseLayout from '../layouts/BaseLayout.astro';
import { localized, path, useTranslations, type Lang } from '../i18n/utils';
import type { UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  route: 'about' | 'gallery';
  titleKey: UiKey;
  bodyKey: UiKey;
}

const { lang, route, titleKey, bodyKey } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t(titleKey)} paths={localized((l) => path(route, l))}>
  <section class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="text-4xl font-bold">{t(titleKey)}</h1>
    <p class="mt-6 text-lg leading-relaxed text-cocoa-soft">{t(bodyKey)}</p>
    <slot />
  </section>
</BaseLayout>
