---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryTile from '../components/CategoryTile.astro';
import { getCategories } from '../lib/catalog';
import { localized, path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const categories = await getCategories();
---

<BaseLayout lang={lang} title={t('products.title')} paths={localized((l) => path('products', l))}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <h1 class="text-5xl">{t('products.title')}</h1>
    <p class="mt-3 text-muted">{t('products.intro')}</p>

    <ul class="mt-10 grid gap-2 lg:grid-cols-2">
      {
        categories.map((category) => (
          <li>
            <CategoryTile category={category} lang={lang} class="h-full" />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
