---
// "Cere ofertă" for custom and wedding cakes. Posts natively (no JS needed) to
// /api/quotes, which stores the photo in R2 and the request in D1, emails the owner
// and redirects to the thank-you page, or back here with `?error=<code>`.
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactFields from '../components/ContactFields.astro';
import { localized, path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const errors = {
  invalid: t('quote.error.invalid'),
  event_date: t('quote.error.event_date'),
  phone: t('quote.error.phone'),
  photo_type: t('quote.error.photo_type'),
  photo_size: t('quote.error.photo_size'),
};
---

<BaseLayout lang={lang} title={t('nav.quote')} paths={localized((l) => path('quote', l))}>
  <section class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="text-5xl">{t('quote.title')}</h1>
    <p class="mt-4 text-lg text-muted">{t('quote.intro')}</p>

    <form
      method="post"
      action="/api/quotes"
      enctype="multipart/form-data"
      class="mt-10 space-y-6 card p-6 sm:p-8"
      data-quote-form
      data-errors={JSON.stringify(errors)}
    >
      <p role="alert" class="rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700" data-error hidden></p>
      <input type="hidden" name="lang" value={lang} />

      <fieldset>
        <legend class="text-sm font-medium">{t('quote.kind')}</legend>
        <div class="mt-2 flex flex-wrap gap-4">
          <label class="flex items-center gap-2">
            <input type="radio" name="kind" value="personalizat" checked class="accent-bronze" />
            {t('quote.kind.personalizat')}
          </label>
          <label class="flex items-center gap-2">
            <input type="radio" name="kind" value="nunta" class="accent-bronze" />
            {t('quote.kind.nunta')}
          </label>
        </div>
      </fieldset>

      <label class="block text-sm font-medium" data-event-date>
        {t('quote.eventDate')}
        <input name="eventDate" type="date" class="field" />
      </label>

      <label class="block text-sm font-medium">
        {t('quote.description')}
        <textarea name="description" rows="5" required maxlength="2000" placeholder={t('quote.descriptionPlaceholder')} class="field"
        ></textarea>
      </label>

      <label class="block text-sm font-medium">
        {t('quote.photo')}
        <input
          name="photo"
          type="file"
          accept="image/*,.heic,.heif"
          class="field file:mr-3 file:rounded-full file:border-0 file:bg-sand file:px-3 file:py-1 file:text-ink"
        />
        <span class="mt-1 block text-xs font-normal text-muted">{t('quote.photoHint')}</span>
      </label>

      <ContactFields lang={lang} addressRequired />

      <p class="text-sm text-muted">{t('order.disclaimer')}</p>
      <p class="text-sm text-muted">
        {t('privacy.formNotice')}{' '}
        <a href={path('privacy', lang)} target="_blank" class="link">{t('privacy.formLink')}</a>.
      </p>
      <button type="submit" class="btn btn-primary">
        {t('quote.submit')}
      </button>
    </form>
  </section>
</BaseLayout>

<script>
  // Wedding cakes also need the event date. `?tip=nunta` preselects the wedding option.
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  if (form) {
    const params = new URLSearchParams(location.search);
    const errors: Record<string, string> = JSON.parse(form.dataset.errors!);
    const error = params.get('error');
    if (error) {
      const box = form.querySelector<HTMLElement>('[data-error]')!;
      box.textContent = errors[error] ?? errors.invalid;
      box.hidden = false;
    }

    // Catch a wrong type or oversized photo before uploading it. `accept` stays broad
    // (image/*) because strict MIME lists grey out valid photos in some OS file pickers.
    const photo = form.querySelector<HTMLInputElement>('input[name="photo"]')!;
    photo.addEventListener('change', () => {
      const file = photo.files?.[0];
      const supported = !file || /\.(jpe?g|png|webp|heic|heif)$/i.test(file.name);
      const tooBig = (file?.size ?? 0) > 10 * 1024 * 1024;
      photo.setCustomValidity(!supported ? errors.photo_type : tooBig ? errors.photo_size : '');
      photo.reportValidity();
    });

    const kind = params.get('tip');
    const preset = form.querySelector<HTMLInputElement>(`input[name="kind"][value="${kind}"]`);
    if (preset) preset.checked = true;

    const eventDate = form.querySelector<HTMLElement>('[data-event-date]');
    eventDate?.querySelector('input')!.setAttribute('min', new Date().toISOString().slice(0, 10));
    const sync = () => {
      const wedding = form.querySelector<HTMLInputElement>('input[name="kind"]:checked')?.value === 'nunta';
      if (!eventDate) return;
      eventDate.hidden = !wedding;
      eventDate.querySelector('input')!.required = wedding;
    };
    form.addEventListener('change', sync);
    sync();
  }
</script>
