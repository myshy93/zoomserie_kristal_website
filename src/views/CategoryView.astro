---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { categoryUrl, getProducts, type Category } from '../lib/catalog';
import { localized, path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  category: Category;
}

const { lang, category } = Astro.props;
const t = useTranslations(lang);
const products = await getProducts(category.id);
---

<BaseLayout
  lang={lang}
  title={category.data.name[lang]}
  description={category.data.description[lang]}
  paths={localized((l) => categoryUrl(category, l))}
>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <a href={path('products', lang)} class="eyebrow hover:text-terracotta">← {t('products.title')}</a>
    <h1 class="mt-2 text-5xl">{category.data.name[lang]}</h1>
    <p class="mt-3 text-charcoal/70">{category.data.description[lang]}</p>

    {
      products.length === 0 ? (
        <p class="mt-10 rounded-2xl bg-pearl-warm p-6 text-charcoal/70">{t('products.empty')}</p>
      ) : (
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((product) => (
            <li>
              <ProductCard product={product} category={category} lang={lang} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
