---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  src: string;
  alt: string;
  isPlaceholder: boolean;
  lang: Lang;
  class?: string;
}

const { src, alt, isPlaceholder, lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<figure class:list={['relative aspect-[4/3] overflow-hidden rounded-2xl bg-cream-deep', className]}>
  <img src={src} alt={isPlaceholder ? '' : alt} loading="lazy" class="size-full object-cover" />
  {
    isPlaceholder && (
      <figcaption class="absolute inset-x-0 bottom-3 text-center text-xs font-medium tracking-wide text-cocoa-soft uppercase">
        {t('product.photoSoon')}
      </figcaption>
    )
  }
</figure>
