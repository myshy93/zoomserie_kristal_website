---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  src: string;
  alt: string;
  isPlaceholder: boolean;
  lang: Lang;
  /** Show the "photo coming soon" note on placeholders. */
  caption?: boolean;
  class?: string;
}

const { src, alt, isPlaceholder, lang, caption = true, class: className } = Astro.props;
const t = useTranslations(lang);
---

<figure class:list={['relative aspect-[4/3] overflow-hidden rounded-2xl bg-pearl-warm', className]}>
  <img
    src={src}
    alt={isPlaceholder ? '' : alt}
    loading="lazy"
    class="size-full object-cover transition duration-500 motion-safe:group-hover:scale-105"
  />
  {
    isPlaceholder && caption && (
      <figcaption class="absolute inset-x-0 bottom-3 text-center text-[11px] font-semibold tracking-widest text-charcoal/50 uppercase">
        {t('product.photoSoon')}
      </figcaption>
    )
  }
</figure>
