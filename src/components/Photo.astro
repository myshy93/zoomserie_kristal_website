---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  src: string;
  alt: string;
  isPlaceholder: boolean;
  lang: Lang;
  class?: string;
}

const { src, alt, isPlaceholder, lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<figure class:list={['relative aspect-[4/3] overflow-hidden rounded-sm bg-sand', className]}>
  <img
    src={src}
    alt={isPlaceholder ? '' : alt}
    loading="lazy"
    class="size-full object-cover transition duration-700 motion-safe:group-hover:scale-105"
  />
  {
    isPlaceholder && (
      <figcaption class="absolute inset-x-0 bottom-3 caps text-center text-[10px] text-muted">
        {t('product.photoSoon')}
      </figcaption>
    )
  }
</figure>
