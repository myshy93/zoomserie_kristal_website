---
// Consent banner. Shown until the visitor chooses; any element with
// `data-open-cookie-settings` (footer link, cookie policy page) reopens it.
import { path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const button = 'btn px-5 py-2';
---

<div
  data-cookie-banner
  role="dialog"
  aria-labelledby="cookie-banner-title"
  hidden
  class="fixed inset-x-4 bottom-4 z-[60] max-w-md rounded-2xl border border-charcoal/10 bg-white p-5 shadow-xl sm:right-auto"
>
  <h2 id="cookie-banner-title" class="text-lg font-bold">{t('cookies.title')}</h2>
  <p class="mt-2 text-sm text-charcoal/70">
    {t('cookies.body')}{' '}
    <a href={path('cookies', lang)} class="link">{t('cookiePolicy.title')}</a>
  </p>

  <div data-cookie-details hidden class="mt-4 space-y-3 text-sm">
    <label class="flex gap-3">
      <input type="checkbox" checked disabled class="mt-1 accent-terracotta-dark" />
      <span>
        <span class="font-semibold">{t('cookies.necessary')}</span>
        <span class="text-charcoal/70">({t('cookies.alwaysOn')})</span><br />
        <span class="text-charcoal/70">{t('cookies.necessaryDesc')}</span>
      </span>
    </label>
    <label class="flex cursor-pointer gap-3">
      <input type="checkbox" name="media" class="mt-1 accent-terracotta-dark" />
      <span>
        <span class="font-semibold">{t('cookies.media')}</span><br />
        <span class="text-charcoal/70">{t('cookies.mediaDesc')}</span>
      </span>
    </label>
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    <!-- Accept and reject get the same weight (EDPB guidance on consent banners). -->
    <button type="button" data-cookie-accept class={`${button} btn-primary`}>
      {t('cookies.acceptAll')}
    </button>
    <button type="button" data-cookie-reject class={`${button} btn-primary`}>
      {t('cookies.rejectAll')}
    </button>
    <button type="button" data-cookie-customize class={`${button} link`}>
      {t('cookies.customize')}
    </button>
    <button
      type="button"
      data-cookie-save
      hidden
      class={`${button} btn-secondary`}
    >
      {t('cookies.save')}
    </button>
  </div>
</div>

<script>
  import { getConsent, setConsent } from '../lib/consent';

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]')!;
  const details = banner.querySelector<HTMLElement>('[data-cookie-details]')!;
  const media = banner.querySelector<HTMLInputElement>('input[name="media"]')!;
  const customize = banner.querySelector<HTMLElement>('[data-cookie-customize]')!;
  const save = banner.querySelector<HTMLElement>('[data-cookie-save]')!;

  function open(withDetails: boolean) {
    media.checked = getConsent()?.media ?? false;
    details.hidden = !withDetails;
    customize.hidden = withDetails;
    save.hidden = !withDetails;
    banner.hidden = false;
  }

  function choose(choice: { media: boolean }) {
    setConsent(choice);
    banner.hidden = true;
  }

  if (!getConsent()) open(false);

  banner.querySelector('[data-cookie-accept]')!.addEventListener('click', () => choose({ media: true }));
  banner.querySelector('[data-cookie-reject]')!.addEventListener('click', () => choose({ media: false }));
  customize.addEventListener('click', () => open(true));
  save.addEventListener('click', () => choose({ media: media.checked }));

  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-open-cookie-settings]')) open(true);
  });
</script>
