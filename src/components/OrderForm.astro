---
// Standard product order request. Submission endpoint (/api/orders → D1 + owner
// notifications) is not implemented yet.
import ContactFields from './ContactFields.astro';
import { site } from '../config/site';
import { formatPrice, useTranslations, type Lang } from '../i18n/utils';
import type { Product } from '../lib/catalog';

interface Props {
  lang: Lang;
  product: Product;
}

const { lang, product } = Astro.props;
const t = useTranslations(lang);
const { pricing, variations, allowsMessage } = product.data;
const input = 'mt-1 w-full rounded-lg border border-cocoa/20 bg-white px-3 py-2 focus:border-berry focus:outline-none';
---

<form method="post" action="/api/orders" class="space-y-6 rounded-3xl bg-white/70 p-6 shadow-sm" data-order-form>
  <h2 class="text-2xl font-bold">{t('order.title')}</h2>
  <input type="hidden" name="product" value={product.id} />
  <input type="hidden" name="lang" value={lang} />

  <div class="grid gap-4 sm:grid-cols-2">
    {
      pricing.length > 1 && (
        <label class="block text-sm font-medium">
          {t('product.price')}
          <select name="unit" class={input}>
            {pricing.map((p) => (
              <option value={p.unit}>
                {formatPrice(p.priceRon, lang)} / {t(`unit.${p.unit}`)}
              </option>
            ))}
          </select>
        </label>
      )
    }
    <label class="block text-sm font-medium">
      {t('order.quantity')}
      <input name="quantity" type="number" min="1" value="1" required class={input} />
    </label>
    {
      variations.map((variation) => (
        <label class="block text-sm font-medium">
          {variation.label[lang]}
          <select name={`variation.${variation.id}`} class={input}>
            {variation.options.map((option) => (
              <option value={option.id}>
                {option.label[lang]}
                {option.priceDeltaRon > 0 && ` (+${formatPrice(option.priceDeltaRon, lang)})`}
              </option>
            ))}
          </select>
        </label>
      ))
    }
  </div>

  {
    allowsMessage && (
      <label class="block text-sm font-medium">
        {t('order.message')}
        <input name="message" maxlength="60" placeholder={t('order.messagePlaceholder')} class={input} />
      </label>
    )
  }

  <fieldset>
    <legend class="text-sm font-medium">{t('order.fulfillment')}</legend>
    <div class="mt-2 flex flex-wrap gap-4">
      <label class="flex items-center gap-2">
        <input type="radio" name="fulfillment" value="delivery" checked class="accent-berry" />
        {t('order.delivery')}
      </label>
      <label class="flex items-center gap-2">
        <input type="radio" name="fulfillment" value="pickup" class="accent-berry" />
        {t('order.pickup')}
      </label>
    </div>
    <p class="mt-1 text-xs text-cocoa-soft">{t('home.delivery.title', { threshold: site.freeDeliveryThresholdRon })}</p>
  </fieldset>

  <ContactFields lang={lang} />

  <label class="block text-sm font-medium">
    {t('order.notes')}
    <textarea name="notes" rows="3" class={input}></textarea>
  </label>

  <p class="text-sm text-cocoa-soft">{t('order.disclaimer')}</p>
  <button type="submit" class="rounded-full bg-berry px-6 py-3 font-semibold text-white hover:bg-berry-dark">
    {t('order.submit')}
  </button>
</form>

<script>
  // Address is only needed (and required) for delivery.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-order-form]')) {
    const address = form.querySelector<HTMLElement>('[data-address]');
    const input = address?.querySelector('input');
    const sync = () => {
      const delivery = form.querySelector<HTMLInputElement>('input[name="fulfillment"]:checked')?.value === 'delivery';
      if (address) address.hidden = !delivery;
      if (input) input.required = delivery;
    };
    form.addEventListener('change', sync);
    sync();
  }
</script>
