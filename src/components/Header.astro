---
import Laurel from './Laurel.astro';
import { site } from '../config/site';
import { languages } from '../i18n/ui';
import { path, useTranslations, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  paths: Record<Lang, string>;
}

const { lang, paths } = Astro.props;
const t = useTranslations(lang);
const current = paths[lang];

const links: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t('nav.home') },
  { key: 'products', label: t('nav.products') },
  { key: 'about', label: t('nav.about') },
  { key: 'gallery', label: t('nav.gallery') },
  { key: 'quote', label: t('nav.quote') },
  { key: 'contact', label: t('nav.contact') },
];

// Home only matches itself: every English URL starts with "/en/".
const isActive = (key: RouteKey, href: string) =>
  current === href || (key !== 'home' && current.startsWith(`${href}/`));
---

<header class="border-b border-ink/10 bg-ivory">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 pt-6 pb-4">
      <p class="caps hidden max-w-[12rem] text-[10px] leading-loose text-muted sm:block">{t('site.motto')}</p>
      <span class="sm:hidden"></span>

      <a href={path('home', lang)} class="group flex flex-col items-center text-center">
        <Laurel class="w-16 text-bronze sm:w-20" />
        <span
          class="font-serif text-3xl leading-none font-medium tracking-[0.18em] uppercase transition-colors group-hover:text-bronze sm:text-5xl"
        >
          {site.name}
        </span>
        <span class="caps mt-2 hidden text-[10px] tracking-[0.3em] text-muted sm:block">{t('site.tagline')}</span>
      </a>

      <div class="flex flex-col items-end gap-3">
        <a href={path('cart', lang)} class="relative p-1 transition hover:text-bronze" aria-label={t('cart.nav')}>
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <path d="M6 8h12l-1 13H7L6 8z" stroke-linejoin="round"></path>
            <path d="M9 10V6a3 3 0 0 1 6 0v4" stroke-linecap="round"></path>
          </svg>
          <span
            class="absolute -top-1 -right-2 flex size-5 items-center justify-center rounded-full bg-bronze text-[10px] font-semibold text-white"
            data-cart-count
            hidden></span>
        </a>
        <ul class="caps flex gap-1.5 text-[11px] text-muted">
          {
            (Object.keys(languages) as Lang[]).map((l, i) => (
              <>
                {i > 0 && <li aria-hidden="true">|</li>}
                <li>
                  {l === lang ? (
                    <span class="text-ink" aria-current="true">
                      {l.toUpperCase()}
                    </span>
                  ) : (
                    <a href={paths[l]} hreflang={l} lang={l} title={languages[l]} class="transition hover:text-bronze">
                      {l.toUpperCase()}
                    </a>
                  )}
                </li>
              </>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="grid items-center gap-4 pb-4 lg:grid-cols-[1fr_auto_1fr]">
      <span class="hidden lg:block"></span>
      <nav class="-mx-4 overflow-x-auto px-4 [scrollbar-width:none] lg:mx-0 lg:px-0">
        <ul class="flex gap-7 font-serif text-lg whitespace-nowrap sm:justify-center lg:gap-9">
          {
            links.map(({ key, label }) => {
              const href = path(key, lang);
              const active = isActive(key, href);
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      'relative inline-block py-1 transition hover:text-bronze',
                      active && 'font-semibold after:absolute after:inset-x-1 after:-bottom-1 after:h-px after:bg-ink',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <a href={path('products', lang)} class="btn btn-primary hidden justify-self-end lg:inline-flex">{t('nav.order')}</a>
    </div>
  </div>
</header>

<script>
  import { cartCount, watchCart } from '../lib/cart';

  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  watchCart((lines) => {
    if (!badge) return;
    const count = cartCount(lines);
    badge.textContent = String(count);
    badge.hidden = count === 0;
  });
</script>
