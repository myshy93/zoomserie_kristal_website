---
import { site } from '../config/site';
import { languages } from '../i18n/ui';
import { path, useTranslations, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  paths: Record<Lang, string>;
}

const { lang, paths } = Astro.props;
const t = useTranslations(lang);
const current = paths[lang];

const links: { key: RouteKey; label: string }[] = [
  { key: 'products', label: t('nav.products') },
  { key: 'about', label: t('nav.about') },
  { key: 'gallery', label: t('nav.gallery') },
  { key: 'contact', label: t('nav.contact') },
];

const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<div class="bg-olive px-4 py-2.5 text-xs font-medium tracking-wider text-pearl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
    <p class="flex items-center gap-2">
      <span class="inline-block size-2 shrink-0 rounded-full bg-bronze" aria-hidden="true"></span>
      {t('home.delivery.title', { threshold: site.freeDeliveryThresholdRon })}
    </p>
    <div class="flex items-center gap-4 text-pearl/80">
      <a href={path('contact', lang)} class="hidden transition hover:text-pearl sm:inline">{t('nav.hoursLocation')}</a>
      <span class="hidden text-pearl/40 sm:inline" aria-hidden="true">|</span>
      <ul class="flex gap-2 font-semibold">
        {
          (Object.keys(languages) as Lang[]).map((l) =>
            l === lang ? (
              <li class="text-pearl" aria-current="true">
                {l.toUpperCase()}
              </li>
            ) : (
              <li>
                <a href={paths[l]} hreflang={l} lang={l} title={languages[l]} class="text-pearl/60 transition hover:text-pearl">
                  {l.toUpperCase()}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-charcoal/10 bg-pearl/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-3 px-4 py-4 sm:px-6 lg:px-8">
    <a href={path('home', lang)} class="group flex flex-col items-start leading-none">
      <span
        class="font-serif text-3xl font-bold tracking-widest text-charcoal uppercase transition-colors group-hover:text-terracotta"
      >
        {site.name}
      </span>
      <span class="mt-1 hidden text-[10px] tracking-[0.25em] text-bronze-dark uppercase sm:block">{t('site.tagline')}</span>
    </a>

    <nav class="order-last -mx-4 w-full overflow-x-auto px-4 md:order-none md:mx-0 md:w-auto md:flex-1 md:px-0">
      <ul class="flex gap-6 text-sm font-medium tracking-wide whitespace-nowrap lg:gap-8">
        {
          links.map(({ key, label }) => {
            const href = path(key, lang);
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    'transition hover:text-terracotta',
                    isActive(href) && 'text-terracotta-dark underline decoration-terracotta underline-offset-8',
                  ]}
                  aria-current={isActive(href) ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-3">
      <a href={path('quote', lang)} class="btn btn-secondary hidden px-4 py-2.5 sm:inline-flex">
        {t('nav.quote')}
      </a>
      <a href={path('cart', lang)} class="btn btn-olive rounded-full px-4 py-2.5" aria-label={t('cart.nav')}>
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="hidden text-xs md:inline">{t('cart.nav')}</span>
        <span
          class="-mr-1 flex size-5 items-center justify-center rounded-full bg-terracotta text-[11px] font-bold text-white"
          data-cart-count
          hidden></span>
      </a>
    </div>
  </div>
</header>

<script>
  import { cartCount, watchCart } from '../lib/cart';

  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  watchCart((lines) => {
    if (!badge) return;
    const count = cartCount(lines);
    badge.textContent = String(count);
    badge.hidden = count === 0;
  });
</script>
