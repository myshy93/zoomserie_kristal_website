---
// Standard products: pick unit, variations, quantity and message, then add to the
// client-side cart (see src/lib/cart.ts). Quote-only products never render this.
import { formatPrice, path, useTranslations, type Lang } from '../i18n/utils';
import { productUrl, type Product } from '../lib/catalog';

interface Props {
  lang: Lang;
  product: Product;
}

const { lang, product } = Astro.props;
const t = useTranslations(lang);
const { pricing, variations, allowsMessage } = product.data;
const input = 'mt-1 w-full rounded-lg border border-cocoa/20 bg-white px-3 py-2 focus:border-berry focus:outline-none';

// Everything the script needs to price a line and show it in the cart in either language.
const config = {
  id: product.id,
  name: product.data.name,
  url: { ro: productUrl(product, 'ro'), en: productUrl(product, 'en') },
  pricing,
  variations: variations.map((v) => ({
    id: v.id,
    options: v.options.map((o) => ({ id: o.id, label: o.label, delta: o.priceDeltaRon })),
  })),
  lang,
  locale: lang === 'ro' ? 'ro-RO' : 'en-GB',
};
---

<form class="space-y-6 rounded-3xl bg-white/70 p-6 shadow-sm" data-add-to-cart data-config={JSON.stringify(config)}>
  <h2 class="text-2xl font-bold">{t('cart.addTitle')}</h2>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      pricing.length > 1 ? (
        <label class="block text-sm font-medium">
          {t('cart.unit')}
          <select name="unit" class={input}>
            {pricing.map((p) => (
              <option value={p.unit}>
                {formatPrice(p.priceRon, lang)} / {t(`unit.${p.unit}`)}
              </option>
            ))}
          </select>
        </label>
      ) : (
        <input type="hidden" name="unit" value={pricing[0].unit} />
      )
    }
    <label class="block text-sm font-medium">
      {t('order.quantity')}
      <input name="quantity" type="number" min="1" step="1" value="1" required class={input} />
    </label>
    {
      variations.map((variation) => (
        <label class="block text-sm font-medium">
          {variation.label[lang]}
          <select name={`variation.${variation.id}`} class={input}>
            {variation.options.map((option) => (
              <option value={option.id}>
                {option.label[lang]}
                {option.priceDeltaRon > 0 && ` (+${formatPrice(option.priceDeltaRon, lang)})`}
              </option>
            ))}
          </select>
        </label>
      ))
    }
  </div>

  {
    allowsMessage && (
      <label class="block text-sm font-medium">
        {t('order.message')}
        <input name="message" maxlength="60" placeholder={t('order.messagePlaceholder')} class={input} />
      </label>
    )
  }

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="rounded-full bg-berry px-6 py-3 font-semibold text-white hover:bg-berry-dark">
      {t('cart.add')}
    </button>
    <p class="text-lg font-semibold text-berry">{t('cart.lineTotal')}: <span data-price></span></p>
  </div>

  <p role="status" class="text-sm text-cocoa-soft" data-feedback hidden>
    {t('cart.added')}
    <a href={path('cart', lang)} class="font-semibold text-berry underline">{t('cart.viewCart')}</a>
  </p>
</form>

<script>
  import { addLine, quantityStep } from '../lib/cart';

  interface Config {
    id: string;
    name: { ro: string; en: string };
    url: { ro: string; en: string };
    pricing: { unit: string; priceRon: number }[];
    variations: { id: string; options: { id: string; label: { ro: string; en: string }; delta: number }[] }[];
    locale: string;
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-add-to-cart]')) {
    const config: Config = JSON.parse(form.dataset.config!);
    const money = new Intl.NumberFormat(config.locale, { style: 'currency', currency: 'RON' });
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
    const quantity = field('quantity') as HTMLInputElement;
    const feedback = form.querySelector<HTMLElement>('[data-feedback]')!;

    const selection = () => {
      const unit = field('unit')!.value;
      const variations: Record<string, string> = {};
      const options: { ro: string; en: string }[] = [];
      let unitPrice = config.pricing.find((p) => p.unit === unit)!.priceRon;
      for (const variation of config.variations) {
        const option = variation.options.find((o) => o.id === field(`variation.${variation.id}`)!.value)!;
        variations[variation.id] = option.id;
        options.push(option.label);
        unitPrice += option.delta;
      }
      return { unit, variations, options, unitPrice };
    };

    const refresh = () => {
      const { unit, unitPrice } = selection();
      const step = quantityStep(unit);
      quantity.step = String(step);
      quantity.min = String(step);
      const qty = Math.max(step, Math.round(Number(quantity.value) / step) * step);
      quantity.value = String(qty);
      form.querySelector('[data-price]')!.textContent = money.format(unitPrice * qty);
    };

    form.addEventListener('input', refresh);
    form.addEventListener('change', () => {
      feedback.hidden = true;
      refresh();
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      refresh();
      const { unit, variations, options, unitPrice } = selection();
      addLine({
        productId: config.id,
        unit,
        variations,
        message: (field('message')?.value ?? '').trim(),
        quantity: Number(quantity.value),
        unitPriceRon: unitPrice,
        display: { name: config.name, options, url: config.url },
      });
      feedback.hidden = false;
    });
    refresh();
  }
</script>
