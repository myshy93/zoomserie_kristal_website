---
import Photo from './Photo.astro';
import { categoryImage, categoryUrl, type Category } from '../lib/catalog';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  category: Category;
  lang: Lang;
}

const { category, lang } = Astro.props;
const t = useTranslations(lang);
const { image, isPlaceholder } = categoryImage(category);
---

<a href={categoryUrl(category, lang)} class="card group flex h-full flex-col overflow-hidden transition hover:border-terracotta/40">
  <Photo src={image} alt={category.data.name[lang]} isPlaceholder={isPlaceholder} lang={lang} class="rounded-none" />
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-2xl font-bold transition group-hover:text-terracotta">{category.data.name[lang]}</h3>
    <p class="mt-1 line-clamp-2 flex-1 text-sm text-charcoal/70">{category.data.description[lang]}</p>
    <p class="mt-4 text-xs font-semibold tracking-wider text-olive uppercase">{t('products.viewCategory')} →</p>
  </div>
</a>
