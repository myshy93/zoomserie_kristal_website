---
// Weekly opening hours. The "open now" badge and today's highlight are filled in the
// browser, since the page itself is static.
import { site, type Weekday } from '../config/site';
import { hoursOn } from '../lib/location';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const weekdayName = new Intl.DateTimeFormat(lang, { weekday: 'long', timeZone: 'UTC' });
const days = ([1, 2, 3, 4, 5, 6, 7] as Weekday[]).map((day) => {
  // 1 Jan 2024 was a Monday.
  const name = weekdayName.format(new Date(Date.UTC(2024, 0, day)));
  return { day, name: name.charAt(0).toUpperCase() + name.slice(1), hours: hoursOn(site.openingHours, day) };
});
---

<div
  data-opening-hours
  data-open-now={t('contact.openNow')}
  data-closed-now={t('contact.closedNow')}
  data-opens-today={t('contact.opensToday')}
  data-opens-tomorrow={t('contact.opensTomorrow')}
  data-opens-on={t('contact.opensOn')}
>
  <h2 class="font-sans text-xs font-bold tracking-wider text-olive uppercase">{t('contact.hours')}</h2>
  <p data-open-status hidden class="mt-2 inline-flex items-center gap-2 rounded-full px-3 py-1 text-sm font-semibold">
    <span class="size-2 rounded-full bg-current" aria-hidden="true"></span>
    <span data-open-status-text></span>
  </p>
  <table class="mt-3 w-full text-sm">
    <tbody>
      {
        days.map(({ day, name, hours }) => (
          <tr data-day={day} data-day-name={name.toLowerCase()} class="border-b border-charcoal/10 last:border-0">
            <th scope="row" class="py-1.5 pr-4 text-left font-normal">
              {name}{' '}
              <span data-today-marker hidden class="text-terracotta-dark">
                · {t('contact.today')}
              </span>
            </th>
            <td class="py-1.5 text-right tabular-nums text-charcoal/70">
              {hours ? `${hours.opens} – ${hours.closes}` : t('contact.closed')}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<script>
  import { site } from '../config/site';
  import { bucharestNow, openStatus } from '../lib/location';

  for (const box of document.querySelectorAll<HTMLElement>('[data-opening-hours]')) {
    const now = new Date();
    const { day } = bucharestNow(now);
    const status = openStatus(site.openingHours, now);
    const fill = (template: string, vars: Record<string, string>) =>
      template.replace(/\{(\w+)\}/g, (_, name) => vars[name] ?? '');

    const today = box.querySelector<HTMLElement>(`[data-day="${day}"]`)!;
    today.classList.add('font-semibold');
    today.querySelector<HTMLElement>('[data-today-marker]')!.hidden = false;

    let text: string;
    if (status.open) {
      text = fill(box.dataset.openNow!, { time: status.closes });
    } else if (!status.opens) {
      text = box.dataset.closedNow!;
    } else {
      const { inDays, time } = status.opens;
      const dayName = box.querySelector<HTMLElement>(`[data-day="${status.opens.day}"]`)!.dataset.dayName!;
      const template = inDays === 0 ? box.dataset.opensToday! : inDays === 1 ? box.dataset.opensTomorrow! : box.dataset.opensOn!;
      text = fill(template, { time, day: dayName });
    }

    const badge = box.querySelector<HTMLElement>('[data-open-status]')!;
    badge.querySelector('[data-open-status-text]')!.textContent = text;
    badge.classList.add(...(status.open ? ['bg-green-100', 'text-green-800'] : ['bg-pearl-warm', 'text-charcoal/70']));
    badge.hidden = false;
  }
</script>
