---
// Weekly opening hours. The "open now" badge and today's highlight are filled in the
// browser, since the page itself is static.
import { site, type Weekday } from '../config/site';
import { hoursOn } from '../lib/location';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Heading level, so the block fits under whatever heading the page already has. */
  headingTag?: 'h2' | 'h3';
  /** Merge neighbouring days with the same hours into one row ("Marți – Sâmbătă"). */
  grouped?: boolean;
}

const { lang, headingTag: Heading = 'h2', grouped = false } = Astro.props;
const t = useTranslations(lang);

const weekdayName = new Intl.DateTimeFormat(lang, { weekday: 'long', timeZone: 'UTC' });
const days = ([1, 2, 3, 4, 5, 6, 7] as Weekday[]).map((day) => {
  // 1 Jan 2024 was a Monday.
  const name = weekdayName.format(new Date(Date.UTC(2024, 0, day)));
  return { day, name: name.charAt(0).toUpperCase() + name.slice(1), hours: hoursOn(site.openingHours, day) };
});

const hoursLabel = (hours: (typeof days)[number]['hours']) => (hours ? `${hours.opens} – ${hours.closes}` : t('contact.closed'));

// One row per day, or one per run of neighbouring days that share the same hours.
const rows: { days: Weekday[]; label: string; times: string }[] = [];
for (const { day, name, hours } of days) {
  const times = hoursLabel(hours);
  const last = rows.at(-1);
  if (grouped && last && last.times === times) {
    last.days.push(day);
    last.label = `${last.label.split(' – ')[0]} – ${name}`;
  } else {
    rows.push({ days: [day], label: name, times });
  }
}
---

<div
  data-opening-hours
  data-open-now={t('contact.openNow')}
  data-closed-now={t('contact.closedNow')}
  data-opens-today={t('contact.opensToday')}
  data-opens-tomorrow={t('contact.opensTomorrow')}
  data-opens-on={t('contact.opensOn')}
  data-day-names={JSON.stringify(Object.fromEntries(days.map((d) => [d.day, d.name.toLowerCase()])))}
>
  <Heading class="caps text-muted">{t('contact.hours')}</Heading>
  <p data-open-status hidden class="mt-2 inline-flex items-center gap-2 text-sm font-medium">
    <span class="size-2 rounded-full bg-current" aria-hidden="true"></span>
    <span data-open-status-text></span>
  </p>
  <table class:list={['mt-3 w-full', grouped ? 'text-base' : 'text-sm']}>
    <tbody>
      {
        rows.map(({ days: rowDays, label, times }) => (
          <tr data-days={rowDays.join(' ')} class="border-b border-ink/10 last:border-0">
            <th scope="row" class="py-1.5 pr-4 text-left font-normal">
              {label}{' '}
              <span data-today-marker hidden class="text-bronze">
                · {t('contact.today')}
              </span>
            </th>
            <td class="py-1.5 text-right tabular-nums text-muted">{times}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<script>
  import { site } from '../config/site';
  import { bucharestNow, openStatus } from '../lib/location';

  for (const box of document.querySelectorAll<HTMLElement>('[data-opening-hours]')) {
    const now = new Date();
    const { day } = bucharestNow(now);
    const status = openStatus(site.openingHours, now);
    const fill = (template: string, vars: Record<string, string>) =>
      template.replace(/\{(\w+)\}/g, (_, name) => vars[name] ?? '');

    const dayNames: Record<string, string> = JSON.parse(box.dataset.dayNames!);
    const today = box.querySelector<HTMLElement>(`[data-days~="${day}"]`)!;
    today.classList.add('font-semibold');
    today.querySelector<HTMLElement>('[data-today-marker]')!.hidden = false;

    let text: string;
    if (status.open) {
      text = fill(box.dataset.openNow!, { time: status.closes });
    } else if (!status.opens) {
      text = box.dataset.closedNow!;
    } else {
      const { inDays, time } = status.opens;
      const dayName = dayNames[status.opens.day];
      const template = inDays === 0 ? box.dataset.opensToday! : inDays === 1 ? box.dataset.opensTomorrow! : box.dataset.opensOn!;
      text = fill(template, { time, day: dayName });
    }

    const badge = box.querySelector<HTMLElement>('[data-open-status]')!;
    badge.querySelector('[data-open-status-text]')!.textContent = text;
    badge.classList.add(status.open ? 'text-green-800' : 'text-muted');
    badge.hidden = false;
  }
</script>
