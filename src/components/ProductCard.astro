---
import Photo from './Photo.astro';
import { productImages, productUrl, type Category, type Product } from '../lib/catalog';
import { formatPrice, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  product: Product;
  category: Category;
  lang: Lang;
}

const { product, category, lang } = Astro.props;
const t = useTranslations(lang);
const { images, isPlaceholder } = productImages(product, category);
const price = product.data.pricing[0];
---

<a
  href={productUrl(product, lang)}
  class="card group flex h-full flex-col overflow-hidden transition hover:border-terracotta/40"
>
  <div class="relative">
    <Photo src={images[0]} alt={product.data.name[lang]} isPlaceholder={isPlaceholder} lang={lang} class="rounded-none" />
    <span class="absolute top-3 right-3 rounded-md bg-white/90 px-2.5 py-1 text-xs font-semibold backdrop-blur-sm">
      {product.data.weight}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex-1">
      <h3 class="text-2xl font-bold transition group-hover:text-terracotta">{product.data.name[lang]}</h3>
      <p class="mt-2 line-clamp-2 text-sm text-charcoal/70">{product.data.description[lang]}</p>
    </div>
    <div class="mt-6 flex items-end justify-between gap-4 border-t border-charcoal/5 pt-4">
      {
        price ? (
          <p>
            <span class="block text-xs text-charcoal/60">{t('product.price')}</span>
            <span class="text-xl font-bold">{formatPrice(price.priceRon, lang)}</span>
            <span class="text-xs font-medium text-charcoal/70"> / {t(`unit.${price.unit}`)}</span>
          </p>
        ) : (
          <p class="text-sm font-semibold text-terracotta-dark">{t('product.requestQuote')}</p>
        )
      }
      <span class="btn btn-olive shrink-0 px-4 py-2.5 text-xs">{t('product.details')}</span>
    </div>
  </div>
</a>
