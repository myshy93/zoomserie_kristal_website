---
// schema.org Bakery structured data (local SEO). Keep it consistent with the Google
// Business Profile: same name, address, phone and hours.
import { site } from '../config/site';
import { mapUrl, openingHoursSpecification } from '../lib/location';
import { path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { postalAddress: a } = site;
// Skip the placeholder Instagram URL (bare instagram.com) until the real profile exists.
const profiles = [site.instagramUrl].filter((url) => new URL(url).pathname.length > 1);

const data = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  '@id': new URL('/#business', site.url).toString(),
  name: site.name,
  url: new URL(path('home', lang), site.url).toString(),
  telephone: site.phone.replace(/\s/g, ''),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: a.streetAddress,
    addressLocality: a.locality,
    addressRegion: a.region,
    postalCode: a.postalCode,
    addressCountry: a.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: mapUrl(),
  openingHoursSpecification: openingHoursSpecification(site.openingHours),
  areaServed: ['Berceni', 'Sector 4, București'],
  currenciesAccepted: 'RON',
  ...(profiles.length > 0 && { sameAs: profiles }),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
