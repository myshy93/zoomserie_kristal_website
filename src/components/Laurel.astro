---
// Decorative olive sprig above the wordmark (and in the footer / quote band). Colour
// follows `currentColor`; size it with a width class.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
// Leaves along the left branch, as [x, y] on the stem; the right branch mirrors it.
const stem: [number, number][] = [
  [42, 17.4],
  [34, 16.2],
  [26, 14.3],
  [18, 11.6],
];
---

<svg viewBox="0 0 100 24" class:list={['h-auto', className]} fill="currentColor" aria-hidden="true">
  {
    [false, true].map((mirrored) => (
      <g transform={mirrored ? 'translate(100 0) scale(-1 1)' : undefined}>
        <path d="M48 18.2C38 17.6 24 15.4 10 8.6" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" />
        {stem.map(([x, y]) => (
          <>
            <ellipse cx={x - 1.5} cy={y - 2.2} rx="4.2" ry="1.4" transform={`rotate(28 ${x - 1.5} ${y - 2.2})`} />
            <ellipse cx={x - 1.5} cy={y + 1.3} rx="4" ry="1.3" transform={`rotate(-8 ${x - 1.5} ${y + 1.3})`} />
          </>
        ))}
        <ellipse cx="7.5" cy="7.4" rx="4" ry="1.4" transform="rotate(30 7.5 7.4)" />
      </g>
    ))
  }
  <circle cx="50" cy="18.6" r="1.3" />
</svg>
