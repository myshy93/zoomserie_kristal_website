---
import Laurel from './Laurel.astro';
import { site } from '../config/site';
import { path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(t('whatsapp.prefill'))}`;
const heading = 'caps text-bronze-dark';
const link = 'transition hover:text-bronze-dark';
---

<footer class="border-t border-ink/10 bg-sand text-ink">
  <div class="mx-auto max-w-7xl px-4 pt-14 pb-10 sm:px-6 lg:px-8">
    <a href={path('home', lang)} class="flex flex-col items-center text-center">
      <Laurel class="w-16 text-bronze-dark" />
      <span class="font-serif text-3xl font-medium tracking-[0.18em] uppercase">{site.name}</span>
      <span class="caps mt-2 text-[10px] tracking-[0.3em] text-ink/70">{t('site.tagline')}</span>
    </a>

    <div class="mt-12 grid gap-10 border-t border-ink/10 pt-10 text-sm sm:grid-cols-3">
      <div class="space-y-3">
        <h2 class={heading}>{t('footer.shop')}</h2>
        <p class="text-ink/80">{site.address}</p>
        <p><a href={path('contact', lang)} class={`${link} font-medium underline underline-offset-4`}>{t('nav.hoursLocation')}</a></p>
      </div>

      <div class="space-y-3">
        <h2 class={heading}>{t('footer.orders')}</h2>
        <p><a href={`tel:${site.phone.replace(/\s/g, '')}`} class={`${link} font-serif text-xl font-medium`}>{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`} class={link}>{site.email}</a></p>
        <p><a href={whatsappHref} target="_blank" rel="noopener" class={link}>WhatsApp</a></p>
        <p><a href={site.instagramUrl} rel="noopener" class={link}>Instagram</a></p>
      </div>

      <div class="space-y-3">
        <h2 class={heading}>{t('footer.info')}</h2>
        <ul class="space-y-2 text-ink/80">
          <li><a href={`${path('contact', lang)}#legal`} class={link}>{t('contact.legal')}</a></li>
          <li><a href={path('privacy', lang)} class={link}>{t('privacy.title')}</a></li>
          <li><a href={path('cookies', lang)} class={link}>{t('cookiePolicy.title')}</a></li>
          <li><button type="button" data-open-cookie-settings class={`${link} cursor-pointer`}>{t('footer.cookieSettings')}</button></li>
          <li><a href="https://anpc.ro/ce-este-sal/" rel="noopener" class={link}>{t('footer.anpc')}</a></li>
        </ul>
      </div>
    </div>

    <p class="caps mt-10 border-t border-ink/10 pt-6 text-center text-[10px] text-ink/70">
      © {year} {site.name}. {t('footer.rights')}
    </p>
  </div>
</footer>
