---
import { site } from '../config/site';
import { path, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(t('whatsapp.prefill'))}`;
const heading = 'font-sans text-xs font-bold tracking-wider text-bronze uppercase';
const link = 'transition hover:text-pearl';
---

<footer class="mt-20 bg-charcoal pt-16 pb-12 text-pearl/80">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 border-b border-pearl/10 pb-12 text-sm sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <p class="font-serif text-3xl font-bold tracking-widest text-pearl uppercase">{site.name}</p>
        <p class="leading-relaxed text-pearl/60">{t('about.body')}</p>
        <a
          href={site.instagramUrl}
          rel="noopener"
          class="inline-flex size-9 items-center justify-center rounded-full bg-pearl/10 text-pearl transition hover:bg-terracotta"
          aria-label="Instagram"
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"></circle>
          </svg>
        </a>
      </div>

      <div class="space-y-3">
        <h2 class={heading}>{t('footer.shop')}</h2>
        <p class="text-pearl/70">{site.address}</p>
        <p><a href={path('contact', lang)} class={`${link} font-medium text-bronze-light`}>{t('nav.hoursLocation')} →</a></p>
      </div>

      <div class="space-y-3">
        <h2 class={heading}>{t('footer.info')}</h2>
        <ul class="space-y-2 text-pearl/70">
          <li><a href={`${path('contact', lang)}#legal`} class={link}>{t('contact.legal')}</a></li>
          <li><a href={path('privacy', lang)} class={link}>{t('privacy.title')}</a></li>
          <li><a href={path('cookies', lang)} class={link}>{t('cookiePolicy.title')}</a></li>
          <li><button type="button" data-open-cookie-settings class={`${link} cursor-pointer`}>{t('footer.cookieSettings')}</button></li>
          <li><a href="https://anpc.ro/ce-este-sal/" rel="noopener" class={link}>{t('footer.anpc')}</a></li>
        </ul>
      </div>

      <div class="space-y-3">
        <h2 class={heading}>{t('footer.orders')}</h2>
        <p><a href={`tel:${site.phone.replace(/\s/g, '')}`} class={`${link} font-semibold text-pearl`}>{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`} class={`${link} text-pearl/70`}>{site.email}</a></p>
        <p><a href={whatsappHref} target="_blank" rel="noopener" class={`${link} text-pearl/70`}>WhatsApp</a></p>
      </div>
    </div>

    <p class="pt-8 text-xs text-pearl/50">© {year} {site.name}. {t('footer.rights')}</p>
  </div>
</footer>
