---
// Photo tile for a category: the photo on top, fading into a text panel with title, rule,
// description and a "view" link, so the photo subject is never covered.
import { categoryImage, categoryUrl, type Category } from '../lib/catalog';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  category: Category;
  lang: Lang;
  class?: string;
}

const { category, lang, class: className } = Astro.props;
const t = useTranslations(lang);
const { image, srcset, isPlaceholder } = categoryImage(category);
---

<a
  href={categoryUrl(category, lang)}
  class:list={['group relative flex flex-col overflow-hidden bg-sand', className]}
>
  <div class="relative aspect-[4/3] flex-1 overflow-hidden">
    <img
      src={image}
      srcset={srcset}
      sizes="(min-width: 1024px) 33vw, 100vw"
      alt=""
      loading="lazy"
      class="absolute inset-0 size-full object-cover transition duration-700 motion-safe:group-hover:scale-105"
    />
    <div
      class="absolute inset-x-0 bottom-0 h-32 bg-[linear-gradient(to_top,var(--color-sand)_0%,color-mix(in_srgb,var(--color-sand)_92%,transparent)_15%,color-mix(in_srgb,var(--color-sand)_72%,transparent)_32%,color-mix(in_srgb,var(--color-sand)_45%,transparent)_50%,color-mix(in_srgb,var(--color-sand)_20%,transparent)_70%,color-mix(in_srgb,var(--color-sand)_6%,transparent)_86%,transparent_100%)]"
    >
    </div>
  </div>
  <div class="relative flex flex-col px-6 pt-1 pb-6 sm:px-8 sm:pb-7">
    <h3 class="text-2xl leading-none tracking-wide uppercase sm:text-3xl">{category.data.name[lang]}</h3>
    <span class="my-3 block h-px w-24 bg-ink/40" aria-hidden="true"></span>
    <p class="font-serif text-lg leading-snug">{category.data.description[lang]}</p>
    <span class="caps mt-4 text-ink transition group-hover:text-bronze-dark">{t('products.viewCategory')} →</span>
  </div>
  {
    isPlaceholder && (
      <span class="caps absolute top-3 right-4 text-[9px] text-muted">
        {t('product.photoSoon')}
      </span>
    )
  }
</a>
